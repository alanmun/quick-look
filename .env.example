# Copy to .env and fill in. .env is gitignored -- never commit it.
#
# These are AMO API credentials, NOT your Mozilla account login. Generate them
# at: https://addons.mozilla.org/developers/addon/api/key/
# (Developer Hub -> Tools -> Manage API Keys). The secret is shown once.
#
# web-ext reads both of these from the environment automatically.
WEB_EXT_API_KEY=user:12345678:123
WEB_EXT_API_SECRET=

# The extension's permanent identity on AMO. Once you sign under an ID it
# cannot be changed, so decide before the first signing run.
EXT_ID=quick-look@alanmun
